# Server configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=zyllotech_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database
DATABASE_PATH=./database/database.sqlite

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Default Admin Seed Credentials (used during initial database creation)
DEFAULT_ADMIN_EMAIL=admin@assetflow.workspace
DEFAULT_ADMIN_PASSWORD=assetflow123
DEFAULT_ADMIN_NAME=Alex Morgan

# Optional SMTP Email Configuration (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@zyllotech.com
